<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthAelrynth: the Aelrynth server plugin. "aelrynth" is one of RynthCore's built-in server ids, so the
       engine's own Aelrynth detection decides when it is active (the hosts here only pick it at load).
       The build is shared (..\Shared\ServerPack\ServerPlugin.props); ServerData.cs holds what is known.
       Aelrynth's own features (AelrynthPlugin.cs, Aelrynth\) came from RynthOracle and RynthInventory on
       2026-10-20: the /top leaderboards and /trial records (a page of the Mini Remote's Server section),
       and the account vault (/mule-data), handed to RynthInventory's Global Inventory. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthAelrynth</AssemblyName>
    <Version>0.2.0</Version>
    <RynthPluginServerId>aelrynth</RynthPluginServerId>
    <RynthPluginServerName>Aelrynth</RynthPluginServerName>
    <RynthPluginServerHosts>aelrynth.com</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Aelrynth*|Aeshnidae*</RynthPluginServerWorldNames>
    <RynthPluginDescription>Aelrynth only: the server card (its mods, links, account setup), Aelrynth's leaderboards and Trials records in the Mini Remote, and the account vault in Global Inventory.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

  <ItemGroup>
    <!-- The vault's server lines vs a player's copy of them, and the storage feed RynthInventory reads. -->
    <Compile Include="..\Shared\ChatSource.cs" Link="Shared\ChatSource.cs" />
    <Compile Include="..\Shared\StorageFeed.cs" Link="Shared\StorageFeed.cs" />
  </ItemGroup>

</Project>
