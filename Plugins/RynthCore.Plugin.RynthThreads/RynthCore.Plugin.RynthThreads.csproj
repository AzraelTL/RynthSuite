<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RynthThreads: DreamWeave's "Threads" gem crafting. Records every Fragment Press result from chat
    (Threads/PressParser.cs) into one file shared by all characters and clients on the PC
    (%LOCALAPPDATA%\RynthCore\RynthThreads\presses.jsonl, Threads/PressStore.cs) and shows the odds
    of each modifier per component (Threads/PressInference.cs). Active only on DreamWeave (world name
    contains "DreamWeave"); elsewhere it stays idle. UI: the engine's script windows (ImGui), a bar
    button and /rthreads; Ui/ is RynthSort's script-window recorder.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>false</StripSymbols>
    <RootNamespace>RynthCore.Plugin.RynthThreads</RootNamespace>
    <AssemblyName>RynthCore.Plugin.RynthThreads</AssemblyName>
    <Platforms>x86</Platforms>
    <!-- Plugin manifest (embedded in the DLL; Plugins\Directory.Build.targets). minEngineApi is the
         highest API use NOT behind a Has*/version check. Nothing above the v66 baseline: the world
         and character names are behind HasGetWorldName / HasGetObjectName, the window behind HasUi
         (script windows, v71). Below v71 it still records (/rthreads stats|export). -->
    <RynthPluginMinEngineApi>66</RynthPluginMinEngineApi>
    <RynthPluginDescription>DreamWeave only: records Fragment Press results and shows the odds of each modifier per component.</RynthPluginDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
  </ItemGroup>

</Project>
